{
  "manifest_version": 3,
  "name": "Compass — School Task Tracker",
  "version": "1.0.0",
  "description": "Track classes, tasks, and syllabus deadlines from a side panel, and add tasks from any page. Syncs with your Compass account.",
  "permissions": ["storage", "sidePanel", "contextMenus"],
  "host_permissions": [
    "https://dannibar-compass-44cf6055d5e3.herokuapp.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Compass",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
